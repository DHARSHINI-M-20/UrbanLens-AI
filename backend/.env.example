# Copy this file to the project root as .env and fill in values for your environment.
# Example local URI: mongodb://localhost:27017
MONGODB_URI=
MONGODB_DATABASE=urbanlens
# Add an authorized Google Maps Platform key only when Street View is implemented.
GOOGLE_MAPS_API_KEY=
AWS_REGION=ap-south-1
BEDROCK_INFERENCE_PROFILE=apac.amazon.nova-lite-v1:0
# Leave pricing blank until verified values are available; null means unavailable.
LOCAL_DETECTOR_COST_PER_INVOCATION=
OCR_COST_PER_INVOCATION=
NOVA_LITE_COST_PER_INVOCATION=
# Optional path when Tesseract is not available on PATH.
TESSERACT_CMD=

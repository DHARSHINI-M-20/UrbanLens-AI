# Local FastAPI through the Vite /api development proxy.
VITE_API_MODE=local
VITE_API_BASE_URL=/api

# AWS cloud mode: set VITE_API_MODE=aws and replace with the deployed HTTP API URL.
# Never put AWS credentials in frontend variables.
# VITE_API_MODE=aws
# VITE_API_BASE_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com